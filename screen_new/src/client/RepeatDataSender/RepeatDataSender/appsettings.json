{
  "RepeatData": {
    "TargetUri": "http://192.168.0.77/data",
    "IntervalMilliseconds": 5000,
    "DelayBetweenMetricsMilliseconds": 1000,
    "Metrics": [
      {
        "Value": "{Load1}",
        "Label": "LOAD 1m",
        "ValueX": 20, "ValueY": 20,
        "MetricX": 20, "MetricY": 60,
        "ValueFontSize": 3, "MetricFontSize": 2
      },
      {
        "Value": "{CpuUsage}%",
        "Label": "CPU",
        "ValueX": 125, "ValueY": 20,
        "MetricX": 125, "MetricY": 60,
        "ValueFontSize": 3, "MetricFontSize": 2
      },
      {
        "Value": "{MemoryUsedPercent}%",
        "Label": "RAM USED",
        "ValueX": 20, "ValueY": 100,
        "MetricX": 20, "MetricY": 140,
        "ValueFontSize": 3, "MetricFontSize": 2
      },
      {
        "Value": "{MemoryAvailableMb} MB",
        "Label": "RAM FREE",
        "ValueX": 125, "ValueY": 100,
        "MetricX": 125, "MetricY": 140,
        "ValueFontSize": 2, "MetricFontSize": 2
      },
      {
        "Value": "{Uptime}",
        "Label": "UPTIME",
        "ValueX": 20, "ValueY": 180,
        "MetricX": 20, "MetricY": 220,
        "ValueFontSize": 2, "MetricFontSize": 2
      },
      {
        "Value": "{BatteryPercent}%",
        "Label": "BATTERY",
        "ValueX": 125, "ValueY": 180,
        "MetricX": 125, "MetricY": 220,
        "ValueFontSize": 3, "MetricFontSize": 2
      }
    ]
  }
}