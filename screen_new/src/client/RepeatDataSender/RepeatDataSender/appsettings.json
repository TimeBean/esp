        "ValueX": 120, "ValueY": 120,
        "MetricX": 120, "MetricY": 160,
        "ValueFontSize": 5, "MetricFontSize": 3
      },
      {
        "Value": "{FreeGb_Root} Gb",
        "Label": "FREE (D2)",
        "ValueX": 120, "ValueY": 120,
        "MetricX": 120, "MetricY": 160,
        "ValueFontSize": 5, "MetricFontSize": 3
      },
      {
        "Value": "{MemoryAvailableGb} Gb",
        "Label": "FREE (RAM)",
        "ValueX": 120, "ValueY": 120,
