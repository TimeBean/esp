@{
    ViewData["Title"] = "Home Page";
}

<div>
    <form id="send-form" asp-controller="Home" asp-action="Send" method="post">
        <label for="address">IP address:</label><br>
        <input type="text" id="address" name="address" value="192.168.0.77/data" required><br><br>

        <label for="message">Message:</label><br>
        <textarea id="message" name="message" rows="5" cols="30"></textarea><br><br>

        <button type="submit" id="send-button">POST</button>
    </form>

    <p id="result" hidden></p>
</div>

<div style="margin-top: 24px;">
    <h3>Send image</h3>

    <form id="send-image-form" asp-controller="Home" asp-action="SendImage" method="post" enctype="multipart/form-data">
        <label for="image-address">IP address:</label><br>
        <input type="text" id="image-address" name="address" value="192.168.0.77/image" required><br><br>

        <label for="file">Image (240×240, will be cropped to fit):</label><br>
        <input type="file" id="file" name="file" accept="image/*" required><br><br>

        <button type="submit" id="send-image-button">Send image</button>
    </form>

    <p id="image-result" hidden></p>
</div>